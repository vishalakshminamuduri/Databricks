   "source": [
    "from pyspark.sql.functions import count\n",
    "\n",
    "df = spark.table(\"silver_customers_3\")\n",
    "\n",
    "gold_df = (\n",
    "    df.groupBy(\"city\")\n",
    "      .agg(count(\"*\").alias(\"customer_count\"))\n",
    ")\n",
    "\n",
    "gold_df.write.mode(\"overwrite\").saveAsTable(\"gold_customer_summary\")\n",
    "\n",
    "display(gold_df)\n",
    "\n",
    "print(\"Gold layer completed\")"
   ]
  }
 ],
