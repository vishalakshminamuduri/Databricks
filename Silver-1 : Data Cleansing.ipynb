   "source": [
    "from pyspark.sql.functions import initcap\n",
    "\n",
    "df = spark.table(\"bronze_customers\")\n",
    "\n",
    "df_clean = (\n",
    "    df\n",
    "    .withColumn(\"name\", initcap(\"name\"))\n",
    "    .withColumn(\"city\", initcap(\"city\"))\n",
    ")\n",
    "\n",
    "df_clean.write.mode(\"overwrite\").saveAsTable(\"silver_customers_1\")\n",
    "\n",
    "print(\"Silver-1 completed\")"
   ]
  }
 ],
